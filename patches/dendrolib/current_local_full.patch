+template <typename T>
+GLOBAL_FUNC __launch_bounds__(GPU_MAX_THREADS_PER_BLOCK) void __read_rb_cg_ensK__(
+    const MeshGPU* const dptr_mesh, const T* const dptr_in, T* const dptr_out,
+    DEVICE_UINT K, DEVICE_UINT member_stride, DEVICE_UINT /*recvBSz*/) {
+    const DEVICE_UINT proc_id = GPUDevice::block_id_y();
+    const DEVICE_UINT var     = GPUDevice::block_id_z();
+    const DEVICE_UINT dof     = GPUDevice::grid_dim_z();
+    const DEVICE_UINT rf      = dptr_mesh->m_cg_recv_f[proc_id];
+    const DEVICE_UINT rc      = dptr_mesh->m_cg_recv_c[proc_id];
+    const DEVICE_UINT cg_sz   = dptr_mesh->m_oct_shared_sz;
+    const DEVICE_UINT stride  = GPUDevice::block_dim_x();
+    const DEVICE_UINT t_id =
+        GPUDevice::thread_id_x() + GPUDevice::block_id_x() * stride;
+    for (DEVICE_UINT mem = 0; mem < K; ++mem) {
+        T* out = dptr_out + mem * member_stride;
+        for (unsigned int k = rf + t_id; k < rf + rc; k += stride) {
+            const DEVICE_UINT rm_sm = dptr_mesh->m_cg_recv_sm[k];
+            const DEVICE_UINT slot  = dof * rf + var * rc + (k - rf);
+            out[var * cg_sz + rm_sm] = dptr_in[K * slot + mem];
+        }
+    }
+}
