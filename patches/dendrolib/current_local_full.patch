+template <typename T, typename stream>
+void MeshGPU::read_from_ghost_cg_ensK_end(
+    ot::AsyncExchangeContex& ctx_host, ot::AsyncExchangeContex& ctx_device,
+    const ot::Mesh* const pMesh, const MeshGPU* const dptr_mesh, T* dptr_vec,
+    unsigned int dof, unsigned int K, unsigned int member_stride, stream s) {
+    if (K < 1) K = 1;
+    if (K == 1) {
+        read_from_ghost_cg_end<T, stream>(ctx_host, ctx_device, pMesh, dptr_mesh,
+                                          dptr_vec, dof, s);
+        return;
+    }
+    if (pMesh->getMPICommSizeGlobal() == 1 || (!pMesh->isActive())) return;
+
+    const std::vector<unsigned int>& se_c = pMesh->getNodalSendCounts();
+    const std::vector<unsigned int>& se_f = pMesh->getNodalSendOffsets();
+    const std::vector<unsigned int>& re_c = pMesh->getNodalRecvCounts();
+    const std::vector<unsigned int>& re_f = pMesh->getNodalRecvOffsets();
+    const std::vector<unsigned int>& send_plist = pMesh->getSendProcList();
+    const std::vector<unsigned int>& recv_plist = pMesh->getRecvProcList();
+    const int active_p         = pMesh->getMPICommSize();
+    const unsigned int sendBSz = (se_f[active_p - 1] + se_c[active_p - 1]);
+    const unsigned int recvBSz = (re_f[active_p - 1] + re_c[active_p - 1]);
+    (void)sendBSz;
+
+    if (recvBSz) {
+#ifdef MPIX_CUDA_AWARE_SUPPORT
+        T* r_buff = (T*)ctx_device.getRecvBuffer();
+        MPI_Waitall(send_plist.size(), ctx_host.m_send_req.data(),
+                    MPI_STATUSES_IGNORE);
+        MPI_Waitall(recv_plist.size(), ctx_host.m_recv_req.data(),
+                    MPI_STATUSES_IGNORE);
+        dim3 gb = dim3(m_max_recv_cg / GPU_MAX_THREADS_PER_BLOCK + 1,
+                       pMesh->getMPICommSize(), dof);
+        dim3 tb = dim3(GPU_MAX_THREADS_PER_BLOCK, 1, 1);
+        __read_rb_cg_ensK__<T><<<gb, tb, 0, s>>>(dptr_mesh, r_buff, dptr_vec, K,
+                                                 member_stride, recvBSz);
+        GPUDevice::stream_synchronize(s);
+#else
+        T* recvB  = (T*)ctx_host.getRecvBuffer();
+        T* r_buff = (T*)ctx_device.getRecvBuffer();
+        MPI_Waitall(send_plist.size(), ctx_host.m_send_req.data(),
+                    MPI_STATUSES_IGNORE);
+        MPI_Waitall(recv_plist.size(), ctx_host.m_recv_req.data(),
+                    MPI_STATUSES_IGNORE);
+        GPUDevice::host_to_device_async(recvB, r_buff, K * recvBSz * dof, s);
+        dim3 gb = dim3(m_max_recv_cg / GPU_MAX_THREADS_PER_BLOCK + 1,
+                       pMesh->getMPICommSize(), dof);
+        dim3 tb = dim3(GPU_MAX_THREADS_PER_BLOCK, 1, 1);
+        __read_rb_cg_ensK__<T><<<gb, tb, 0, s>>>(dptr_mesh, r_buff, dptr_vec, K,
+                                                 member_stride, recvBSz);
+        GPUDevice::stream_synchronize(s);
+#endif
+    }
+}
