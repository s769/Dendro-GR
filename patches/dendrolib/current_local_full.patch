+/** One-shot: unique CG ids + adjacent-jump lex vs sorted (queue #7). */
+template <DEVICE_UINT p>
+GLOBAL_FUNC void __unzip_gather_unique_stats(
+    const MeshGPU* const dptr_mesh, const DEVICE_UINT* ele_ids,
+    DEVICE_UINT* unique_counts, DEVICE_UINT* jump_lex,
+    DEVICE_UINT* jump_sorted) {
+    const DEVICE_UINT ele =
+        (ele_ids != nullptr) ? ele_ids[GPUDevice::block_id_x()]
+                             : static_cast<DEVICE_UINT>(GPUDevice::block_id_x());
+    if (GPUDevice::thread_id_x() != 0 || GPUDevice::thread_id_y() != 0) return;
+    const DEVICE_UINT nx  = p + 1;
+    const DEVICE_UINT nPe = nx * nx * nx;
+    const DEVICE_UINT* const e2n_cg = dptr_mesh->m_e2n_cg;
+    DEVICE_UINT uniq = 0;
+    DEVICE_UINT jlex = 0;
+    for (DEVICE_UINT i = 0; i < nPe; ++i) {
+        const DEVICE_UINT id = e2n_cg[ele * nPe + i];
+        DEVICE_BOOL seen     = false;
+        for (DEVICE_UINT j = 0; j < i; ++j) {
+            if (e2n_cg[ele * nPe + j] == id) {
+                seen = true;
+                break;
+            }
+        }
+        if (!seen) ++uniq;
+        if (i + 1 < nPe) {
+            const DEVICE_UINT a = e2n_cg[ele * nPe + i];
+            const DEVICE_UINT b = e2n_cg[ele * nPe + i + 1];
+            jlex += (a > b) ? (a - b) : (b - a);
+        }
+    }
+    // insertion-sort copy for sorted adjacent jumps (nPe=343, once)
+    DEVICE_UINT ids[343];
+#pragma unroll 1
+    for (DEVICE_UINT i = 0; i < nPe; ++i) ids[i] = e2n_cg[ele * nPe + i];
+    for (DEVICE_UINT i = 1; i < nPe; ++i) {
+        DEVICE_UINT key = ids[i];
+        DEVICE_INT j    = (DEVICE_INT)i - 1;
+        while (j >= 0 && ids[j] > key) {
+            ids[j + 1] = ids[j];
+            --j;
+        }
+        ids[j + 1] = key;
+    }
+    DEVICE_UINT jsort = 0;
+    for (DEVICE_UINT i = 0; i + 1 < nPe; ++i) {
+        const DEVICE_UINT a = ids[i];
+        const DEVICE_UINT b = ids[i + 1];
+        jsort += (a > b) ? (a - b) : (b - a);
+    }
+    const DEVICE_UINT bx = GPUDevice::block_id_x();
+    unique_counts[bx]    = uniq;
+    jump_lex[bx]         = jlex;
+    jump_sorted[bx]      = jsort;
+}
