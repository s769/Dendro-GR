@@ -275,6 +275,66 @@ MeshGPU* MeshGPU::alloc_mesh_on_device(const ot::Mesh* pMesh) {
     GPUDevice::host_to_device_async<HangingInfo, cudaStream_t>(
         hanging_info, this->m_hinfo, pNodes.size());
 
+    // Tier-2 unzip: active (nmap>0) element IDs + hang/nh subsets.
+    {
+        std::vector<DEVICE_UINT> active_ids;
+        std::vector<DEVICE_UINT> hang_ids;
+        std::vector<DEVICE_UINT> nh_ids;
+        active_ids.reserve(pNodes.size());
+        hang_ids.reserve(pNodes.size() / 4);
+        nh_ids.reserve(pNodes.size());
+        unsigned int skipped = 0;
+        for (unsigned int ele = 0; ele < pNodes.size(); ele++) {
+            const unsigned int nmap =
+                (ele < m2b_c.size()) ? m2b_c[ele] : 0u;
+            if (nmap == 0) {
+                skipped++;
+                continue;
+            }
+            active_ids.push_back(ele);
+            if (hanging_info[ele].hflag != 0)
+                hang_ids.push_back(ele);
+            else
+                nh_ids.push_back(ele);
+        }
+        this->m_num_ele_active = static_cast<DEVICE_UINT>(active_ids.size());
+        this->m_num_ele_hang   = static_cast<DEVICE_UINT>(hang_ids.size());
+        this->m_num_ele_nh     = static_cast<DEVICE_UINT>(nh_ids.size());
+        this->m_ele_ids_active =
+            GPUDevice::device_malloc<DEVICE_UINT>(active_ids.size() > 0
+                                                      ? active_ids.size()
+                                                      : 1);
+        this->m_ele_ids_hang =
+            GPUDevice::device_malloc<DEVICE_UINT>(hang_ids.size() > 0
+                                                      ? hang_ids.size()
+                                                      : 1);
+        this->m_ele_ids_nh =
+            GPUDevice::device_malloc<DEVICE_UINT>(nh_ids.size() > 0
+                                                      ? nh_ids.size()
+                                                      : 1);
+        if (!active_ids.empty())
+            GPUDevice::host_to_device_async<DEVICE_UINT, cudaStream_t>(
+                active_ids.data(), this->m_ele_ids_active, active_ids.size());
+        if (!hang_ids.empty())
+            GPUDevice::host_to_device_async<DEVICE_UINT, cudaStream_t>(
+                hang_ids.data(), this->m_ele_ids_hang, hang_ids.size());
+        if (!nh_ids.empty())
+            GPUDevice::host_to_device_async<DEVICE_UINT, cudaStream_t>(
+                nh_ids.data(), this->m_ele_ids_nh, nh_ids.size());
+        GPUDevice::host_to_device(this, dptr_mesh, 1);
+        if (pMesh->getMPIRank() == 0) {
+            const double hang_frac =
+                active_ids.empty()
+                    ? 0.0
+                    : (100.0 * static_cast<double>(hang_ids.size()) /
+                       static_cast<double>(active_ids.size()));
+            printf("[unzip-split] elements=%zu active=%zu skipped0=%u "
+                   "hang=%zu (%.1f%% of active) nh=%zu\n",
+                   pNodes.size(), active_ids.size(), skipped, hang_ids.size(),
+                   hang_frac, nh_ids.size());
+        }
+    }
+
     const Point pt_min = pMesh->getDomainMinPt();
