+    /**@brief: pinned host memory pool. cudaMallocHost/cudaFreeHost cost
+     * tens to hundreds of ms for large buffers and are called at every
+     * remesh; freed blocks are cached in size buckets (x1.25 steps) and
+     * reused. Cached bytes are capped (DENDRO_PINNED_POOL_MAX_GB, default 24);
+     * DENDRO_PINNED_POOL=0 disables the cache (direct cudaMallocHost).*/
+    static void* pinned_pool_alloc(size_t bytes) {
+        PinnedPool& P = pinned_pool();
+        if (!P.enabled) {
+            void* p;
+            check_error(cudaMallocHost(&p, bytes));
+            return p;
+        }
+        size_t cap = P.bucket(bytes);
+        {
+            std::lock_guard<std::mutex> lk(P.mtx);
+            auto it = P.free_by_cap.find(cap);
+            if (it != P.free_by_cap.end() && !it->second.empty()) {
+                void* p = it->second.back();
+                it->second.pop_back();
+                P.cached_bytes -= cap;
+                P.live[p] = cap;
+                return p;
+            }
+        }
+        void* p;
+        check_error(cudaMallocHost(&p, cap));
+        std::lock_guard<std::mutex> lk(P.mtx);
+        P.live[p] = cap;
+        return p;
+    }
+
+    static void pinned_pool_free(void* p) {
+        if (p == nullptr) return;
+        PinnedPool& P = pinned_pool();
+        if (!P.enabled) {
+            check_error(cudaFreeHost(p));
+            return;
+        }
+        std::lock_guard<std::mutex> lk(P.mtx);
+        auto it = P.live.find(p);
+        if (it == P.live.end()) {  // not ours
+            check_error(cudaFreeHost(p));
+            return;
+        }
+        size_t cap = it->second;
+        P.live.erase(it);
+        P.free_by_cap[cap].push_back(p);
+        P.cached_bytes += cap;
+        // evict largest cached buffers beyond the cap
+        while (P.cached_bytes > P.max_cached) {
+            auto big = P.free_by_cap.end();
+            for (auto b = P.free_by_cap.begin(); b != P.free_by_cap.end();
+                 ++b)
+                if (!b->second.empty() &&
+                    (big == P.free_by_cap.end() || b->first > big->first))
+                    big = b;
+            if (big == P.free_by_cap.end()) break;
+            void* q = big->second.back();
+            big->second.pop_back();
+            P.cached_bytes -= big->first;
+            check_error(cudaFreeHost(q));
+        }
+    }
