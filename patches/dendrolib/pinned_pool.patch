+    struct PinnedPool {
+        std::mutex mtx;
+        std::map<size_t, std::vector<void*>> free_by_cap;
+        std::unordered_map<void*, size_t> live;
+        size_t cached_bytes = 0;
+        size_t max_cached   = (size_t)24 << 30;
+        bool enabled        = true;
+        PinnedPool() {
+            const char* e = std::getenv("DENDRO_PINNED_POOL");
+            if (e && e[0] == '0') enabled = false;
+            const char* g = std::getenv("DENDRO_PINNED_POOL_MAX_GB");
+            if (g) max_cached = (size_t)(atof(g) * (double)((size_t)1 << 30));
+        }
+        // round up to a x1.25 geometric bucket (>= 4 KiB)
+        size_t bucket(size_t b) const {
+            size_t c = 4096;
+            while (c < b) c = c + (c >> 2);
+            return c;
+        }
+    };
+    static PinnedPool& pinned_pool() {
+        static PinnedPool P;
+        return P;
+    }
