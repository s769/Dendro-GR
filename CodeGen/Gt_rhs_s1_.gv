"Symbol('grad_0_Gt2[pp]')_(0, 1)" ["color"="black", "label"="grad_0_Gt2[pp]", "shape"="ellipse"];
"Mul(Symbol('beta1[pp]'), Symbol('grad_1_Gt2[pp]'))_(1,)" ["color"="black", "label"="Mul", "shape"="ellipse"];
"Symbol('beta1[pp]')_(1, 0)" ["color"="black", "label"="beta1[pp]", "shape"="ellipse"];
"Symbol('grad_1_Gt2[pp]')_(1, 1)" ["color"="black", "label"="grad_1_Gt2[pp]", "shape"="ellipse"];
"Mul(Symbol('beta2[pp]'), Symbol('grad_2_Gt2[pp]'))_(2,)" ["color"="black", "label"="Mul", "shape"="ellipse"];
"Symbol('beta2[pp]')_(2, 0)" ["color"="black", "label"="beta2[pp]", "shape"="ellipse"];
"Symbol('grad_2_Gt2[pp]')_(2, 1)" ["color"="black", "label"="grad_2_Gt2[pp]", "shape"="ellipse"];

#########
# Edges #
#########

"Add(Mul(Symbol('beta0[pp]'), Symbol('grad_0_Gt2[pp]')), Mul(Symbol('beta1[pp]'), Symbol('grad_1_Gt2[pp]')), Mul(Symbol('beta2[pp]'), Symbol('grad_2_Gt2[pp]')))_()" -> "Mul(Symbol('beta0[pp]'), Symbol('grad_0_Gt2[pp]'))_(0,)";
"Add(Mul(Symbol('beta0[pp]'), Symbol('grad_0_Gt2[pp]')), Mul(Symbol('beta1[pp]'), Symbol('grad_1_Gt2[pp]')), Mul(Symbol('beta2[pp]'), Symbol('grad_2_Gt2[pp]')))_()" -> "Mul(Symbol('beta1[pp]'), Symbol('grad_1_Gt2[pp]'))_(1,)";
"Add(Mul(Symbol('beta0[pp]'), Symbol('grad_0_Gt2[pp]')), Mul(Symbol('beta1[pp]'), Symbol('grad_1_Gt2[pp]')), Mul(Symbol('beta2[pp]'), Symbol('grad_2_Gt2[pp]')))_()" -> "Mul(Symbol('beta2[pp]'), Symbol('grad_2_Gt2[pp]'))_(2,)";
"Mul(Symbol('beta0[pp]'), Symbol('grad_0_Gt2[pp]'))_(0,)" -> "Symbol('beta0[pp]')_(0, 0)";
"Mul(Symbol('beta0[pp]'), Symbol('grad_0_Gt2[pp]'))_(0,)" -> "Symbol('grad_0_Gt2[pp]')_(0, 1)";
"Mul(Symbol('beta1[pp]'), Symbol('grad_1_Gt2[pp]'))_(1,)" -> "Symbol('beta1[pp]')_(1, 0)";
"Mul(Symbol('beta1[pp]'), Symbol('grad_1_Gt2[pp]'))_(1,)" -> "Symbol('grad_1_Gt2[pp]')_(1, 1)";
"Mul(Symbol('beta2[pp]'), Symbol('grad_2_Gt2[pp]'))_(2,)" -> "Symbol('beta2[pp]')_(2, 0)";
"Mul(Symbol('beta2[pp]'), Symbol('grad_2_Gt2[pp]'))_(2,)" -> "Symbol('grad_2_Gt2[pp]')_(2, 1)";
