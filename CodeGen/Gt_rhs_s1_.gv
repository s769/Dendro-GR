digraph{

# Graph style
"ordering"="out"
"rankdir"="TD"

#########
# Nodes #
#########

"Add(Mul(Symbol('beta0[pp]'), Symbol('grad_0_Gt2[pp]')), Mul(Symbol('beta1[pp]'), Symbol('grad_1_Gt2[pp]')), Mul(Symbol('beta2[pp]'), Symbol('grad_2_Gt2[pp]')))_()" ["color"="black", "label"="Add", "shape"="ellipse"];
"Mul(Symbol('beta0[pp]'), Symbol('grad_0_Gt2[pp]'))_(0,)" ["color"="black", "label"="Mul", "shape"="ellipse"];
